[options]
mode bmc
expect pass
depth 64

[engines]
smtbmc boolector

[script]
read -sv defines.sv
read_verilog -sv wrapper.sv
read_verilog -sv Cl1Top_AXI_CACHE.sv
read -sv cl1_csr_exec_ch0.sv
prep -flatten -nordff -top rvfi_testbench
chformal -early

[files]
cl1_csr_exec_check.sv
../wrapper.sv
../Cl1Top_AXI_CACHE.sv
../../../checks/rvfi_macros.vh
../../../checks/rvfi_channel.sv
../../../checks/rvfi_testbench.sv

[file defines.sv]
`define RISCV_FORMAL
`define RISCV_FORMAL_NRET 1
`define RISCV_FORMAL_XLEN 32
`define RISCV_FORMAL_ILEN 32
`define RISCV_FORMAL_NBUS 2
`define RISCV_FORMAL_BUSLEN 32
`define RISCV_FORMAL_RESET_CYCLES 1
`define RISCV_FORMAL_CHECK_CYCLE 63
`define RISCV_FORMAL_CHANNEL_IDX 0
`define RISCV_FORMAL_CHECKER cl1_csr_exec_check
`define RISCV_FORMAL_COMPRESSED
`define RISCV_FORMAL_ALIGNED_MEM
`define RISCV_FORMAL_ALTOPS
`define RISCV_FORMAL_CSR_MSTATUS
`define RISCV_FORMAL_CSR_MIE
`define RISCV_FORMAL_CSR_MIP
`define RISCV_FORMAL_CSR_MTVEC
`define RISCV_FORMAL_CSR_MEPC
`define RISCV_FORMAL_CSR_MCAUSE
`define RISCV_FORMAL_CSR_MTVAL
`define RISCV_FORMAL_CSR_MSCRATCH
`define RISCV_FORMAL_CSR_MISA
`define RISCV_FORMAL_MEM_FAULT
`define RISCV_FORMAL_INTERRUPT
`define CL1_FORMAL_ASSUME_ALIGNED_32I
`define CL1_USE_AXI_CACHE_DUT
`define CL1_AXI_FAST_FORMAL_MEM
`define CL1_AXI_FAULT_FORMAL_MEM
`define RISCV_FORMAL_IOADDR(addr) (((addr) >= 32'h00000000 && (addr) <= 32'h00000fff) || ((addr) >= 32'h10000000 && (addr) <= 32'h10000fff))
`include "rvfi_macros.vh"

[file cl1_csr_exec_ch0.sv]
`include "defines.sv"
`include "rvfi_channel.sv"
`include "rvfi_testbench.sv"
`include "cl1_csr_exec_check.sv"
