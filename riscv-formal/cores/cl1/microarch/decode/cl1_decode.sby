[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
expect pass
depth 4

[engines]
smtbmc boolector

[script]
read_verilog -formal -sv -DSYNTHESIS -DRISCV_FORMAL_MICROARCH_DECODE Cl1Top_AXI_CACHE.sv
read_verilog -formal -sv cl1_decode_check.sv
prep -flatten -nordff -top cl1_decode_check
chformal -early

[files]
cl1_decode_check.sv
../../Cl1Top_AXI_CACHE.sv
