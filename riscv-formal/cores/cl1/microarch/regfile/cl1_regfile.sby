[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
expect pass
depth 8

[engines]
smtbmc boolector

[script]
read_verilog -formal -sv -DSYNTHESIS -DRISCV_FORMAL_MICROARCH_REGFILE Cl1Top_AXI_CACHE.sv
read_verilog -formal -sv cl1_regfile_check.sv
prep -flatten -nordff -top cl1_regfile_check
chformal -early

[files]
cl1_regfile_check.sv
../../Cl1Top_AXI_CACHE.sv
